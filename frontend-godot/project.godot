; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited directly.

config_version=5

[application]

config/name="DeepSeek Harness"
config/description="Next-Generation High-Performance AI Agent Desktop Client"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/min_width=960
window/size/min_height=600
window/dpi/allow_hidpi=true

[gui]

theme/custom_font=""
theme/default_font_antialiasing=1
theme/default_font_generate_mipmaps=true

[rendering]

renderer/rendering_method="forward_plus"

