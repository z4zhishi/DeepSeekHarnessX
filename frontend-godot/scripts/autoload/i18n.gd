func _ready() -> void:
	var stored := _read_file()
	if stored == "zh" or stored == "en":
		_locale = stored


func t(key: String) -> String:
	var dict: Dictionary = _zh if _locale == "zh" else _en
	var text := str(dict.get(key, ""))
	if text == "":
		return key
	return text


func set_locale(loc: String) -> void:
	if loc != "zh" and loc != "en":
		loc = FALLBACK_LOCALE
	if _locale == loc:
		return
	_locale = loc
	_write_file(loc)
	locale_changed.emit(loc)


func get_locale() -> String:
	return _locale


func is_zh() -> bool:
	return _locale == "zh"


func _read_file() -> String:
	if not FileAccess.file_exists(LOCALE_PATH):
		return ""
	return FileAccess.get_file_as_string(LOCALE_PATH).strip_edges()


func _write_file(loc: String) -> void:
	var f := FileAccess.open(LOCALE_PATH, FileAccess.WRITE)
	if f == null:
		return
	f.store_string(loc)
	f.close()
